# GovSec local environment. Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# --- databases: one schema per service (TAD §9.2) ---
IDENTITY_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=identity
INVESTOR_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=investor
AUCTION_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=auction
BOT_GATEWAY_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=bot_gateway
CBS_GATEWAY_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=cbs_gateway
SETTLEMENT_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=settlement
NOTIFICATION_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=notification

# --- ports ---
IDENTITY_PORT=3101
INVESTOR_PORT=3102
AUCTION_PORT=3103
BOT_GATEWAY_PORT=3104
CBS_GATEWAY_PORT=3105
SETTLEMENT_PORT=3106
NOTIFICATION_PORT=3107

# --- messaging ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# --- tokens: HS256 in development only; production requires RS256 (TAD §10.1) ---
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_STEP_UP_SECRET=dev-only-step-up-secret-change-me
JWT_ISSUER=govsec-identity
JWT_AUDIENCE=govsec
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
# JWT_PUBLIC_KEY=  (PEM, when JWT_ALGORITHM=RS256)
# JWT_PRIVATE_KEY= (PEM, identity only, when JWT_ALGORITHM=RS256)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h
STEP_UP_TOKEN_TTL=5m

# --- investor sign-in (identity) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
# Development only: every OTP is this code, so sign-up works without a phone.
OTP_FIXED_CODE=123456
PIN_MAX_ATTEMPTS=5
# Development only: staff sign in with username + password (scripts/dev-seed-staff.mjs).
STAFF_PASSWORD_LOGIN=true
NOTIFICATION_URL=http://localhost:3107

# --- investor onboarding ---
IDENTITY_URL=http://localhost:3101
CBS_GATEWAY_URL=http://localhost:3105
# stub until TCB's NIDA and sanctions/PEP screening subscriptions are available
NIDA_MODE=stub
SCREENING_MODE=stub
KYC_SLA_HOURS=24
CONSENT_VERSION=2026-09

# --- service-to-service ---
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# --- Bank of Tanzania GSS API (bot-gateway only) ---
# Local development points at the BoT simulator (apps/bot-simulator). Run
# scripts/dev-bot-keys.sh once to create the keys. For the BoT sandbox, replace these
# with the values BoT issues at onboarding and set BOT_ENVIRONMENT=sandbox with no
# BOT_BASE_URL override.
BOT_ENVIRONMENT=sandbox
BOT_BASE_URL=http://localhost:3199
BOT_API_KEY=sim-api-key
BOT_INTERFACE_CODE=BOT-I-GSS-099
BOT_SENDER_CODE=TCB_TZ
BOT_USERNAME=TCB
BOT_PARTICIPANT_CODE=TCBGSP01
BOT_PRIVATE_KEY_PATH=./secrets/tcb-bot-private.pem
BOT_PUBLIC_KEY_PATH=./secrets/bot-public.pem
BOT_AUCTION_SYNC_MS=300000
# Check submitted batches against GET /bids (ms); 0 disables
BOT_RECONCILE_MS=60000
# Cross-check callback allotments against /winners totals (ms); 0 disables
BOT_WINNERS_CHECK_MS=300000
# The name BoT shows for TCB on /winners (spec gap B1); confirm with BoT
BOT_INVESTOR_NAME="TANZANIA COMMERCIAL BANK"

# --- BoT simulator (development only) ---
BOT_SIM_PORT=3199
BOT_SIM_PRIVATE_KEY_PATH=./secrets/bot-sim-private.pem
BOT_SIM_PARTICIPANT_PUBLIC_KEY_PATH=./secrets/tcb-bot-public.pem
BOT_SIM_CALLBACK_URL=http://localhost:3104/bot/callback

# --- TCB Core Banking (cbs-gateway only) ---
CBS_MODE=stub
CBS_BASE_URL=
