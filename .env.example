# GovSec local environment. Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# --- databases: one schema per service (TAD §9.2) ---
IDENTITY_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=identity
INVESTOR_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=investor
AUCTION_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=auction
BOT_GATEWAY_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=bot_gateway
CBS_GATEWAY_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=cbs_gateway
SETTLEMENT_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=settlement
NOTIFICATION_DATABASE_URL=postgresql://govsec:govsec@localhost:5432/govsec_dev?schema=notification

# --- ports ---
IDENTITY_PORT=3101
INVESTOR_PORT=3102
AUCTION_PORT=3103
BOT_GATEWAY_PORT=3104
CBS_GATEWAY_PORT=3105
SETTLEMENT_PORT=3106
NOTIFICATION_PORT=3107

# --- messaging ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# --- tokens: HS256 in development only; production requires RS256 (TAD §10.1) ---
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_STEP_UP_SECRET=dev-only-step-up-secret-change-me
JWT_ISSUER=govsec-identity
JWT_AUDIENCE=govsec
# JWT_PUBLIC_KEY=  (PEM, when JWT_ALGORITHM=RS256)

# --- service-to-service ---
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# --- Bank of Tanzania GSS API (bot-gateway only; values issued at BoT onboarding) ---
BOT_ENVIRONMENT=sandbox
# BOT_BASE_URL=            overrides the gateway for the environment
BOT_API_KEY=
BOT_INTERFACE_CODE=
BOT_SENDER_CODE=
BOT_USERNAME=
BOT_PARTICIPANT_CODE=
BOT_PRIVATE_KEY_PATH=./secrets/tcb-bot-private.pem
BOT_PUBLIC_KEY_PATH=./secrets/bot-public.pem

# --- TCB Core Banking (cbs-gateway only) ---
CBS_MODE=stub
CBS_BASE_URL=
