// GovSec — BoT Gateway service datastore.
//
// The only service that talks to the Bank of Tanzania GSS API: signing, tokens, bids, winners, callbacks (TAD §7.3).
//
// Owns the PostgreSQL schema "bot_gateway" exclusively. No other service reads
// or writes it; other services learn about its state through events (TAD §9.2).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox (TAD §7.5). A row is written in the same transaction as the
/// state change it announces; the relay publishes it to RabbitMQ afterwards.
model OutboxMessage {
  id             BigInt    @id @default(autoincrement())
  aggregateType  String    @map("aggregate_type") @db.VarChar(50)
  aggregateId    String    @map("aggregate_id") @db.VarChar(64)
  eventType      String    @map("event_type") @db.VarChar(100)
  payload        Json
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(200)
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  @@index([sentAt, id])
  @@map("outbox_messages")
}

/// Every callback BoT has sent, exactly once (TAD §7.3).
///
/// BoT may deliver the same event more than once. `dedupe_key` is a hash of the signed
/// body, so a redelivery is recognised, acknowledged again and not processed twice.
model BotCallback {
  id             String   @id @default(uuid()) @db.Uuid
  dedupeKey      String   @unique @map("dedupe_key") @db.VarChar(64)
  requestId      String?  @map("request_id") @db.VarChar(64)
  batchReference String?  @map("batch_reference") @db.VarChar(32)
  isin           String?  @db.VarChar(12)
  status         String?  @db.VarChar(40)
  message        String?
  payload        Json
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([requestId])
  @@index([batchReference])
  @@map("bot_callbacks")
}

/// The last version of each auction seen on GET /auctions, so a poll can tell a new
/// auction from a changed one from an unchanged one.
model AuctionSnapshot {
  isin        String   @id @db.VarChar(12)
  hash        String   @db.VarChar(64)
  payload     Json
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("auction_snapshots")
}

/// One row per batch sent to BoT: the audit record of what was submitted, by whom and
/// when. The batch reference is BoT's idempotency key, so it is the primary key here.
model BatchSubmission {
  batchReference   String   @id @map("batch_reference") @db.VarChar(32)
  requestedBy      String   @map("requested_by") @db.VarChar(40)
  bidsSubmitted    Int      @map("bids_submitted")
  totalFaceValue   Decimal  @map("total_face_value") @db.Decimal(20, 2)
  alreadySubmitted Boolean  @map("already_submitted")
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// Exactly what was sent, so the batch can be checked against what BoT holds.
  packages         Json     @default("[]")
  /// pending until BoT is confirmed to hold every bid; then matched, or breaks.
  reconcileStatus  String   @default("pending") @map("reconcile_status") @db.VarChar(20)
  reconcileAttempts Int     @default(0) @map("reconcile_attempts")
  reconciledAt     DateTime? @map("reconciled_at") @db.Timestamptz(6)
  breaks           Json?

  @@index([reconcileStatus, submittedAt])
  @@map("batch_submissions")
}

/// Cross-check of allotments received by callback against BoT's /winners totals, per
/// ISIN. /winners cannot say whose allotment is whose (Appendix B, B1), so totals are
/// the one thing it can confirm.
model WinnersCheck {
  isin           String   @id @db.VarChar(12)
  status         String   @db.VarChar(20)
  callbacksTotal Decimal  @map("callbacks_total") @db.Decimal(20, 2)
  winnersTotal   Decimal  @map("winners_total") @db.Decimal(20, 2)
  attempts       Int      @default(1)
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("winners_checks")
}
