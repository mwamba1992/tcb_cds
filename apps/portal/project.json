{
  "name": "portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal/src",
  "tags": ["type:app", "domain:portal"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vue-tsc --noEmit -p apps/portal/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-investor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --mode investor --outDir ../../dist/apps/portal-investor --emptyOutDir",
        "cwd": "apps/portal"
      }
    },
    "build-staff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --mode staff --outDir ../../dist/apps/portal-staff --emptyOutDir",
        "cwd": "apps/portal"
      }
    }
  }
}
