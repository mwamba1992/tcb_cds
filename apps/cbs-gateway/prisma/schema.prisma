// GovSec — Core Banking Gateway service datastore.
//
// The only service that talks to TCB Core Banking: account lookup, holds, debits, GL postings (TAD §7.2).
//
// Owns the PostgreSQL schema "cbs_gateway" exclusively. No other service reads
// or writes it; other services learn about its state through events (TAD §9.2).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox (TAD §7.5). A row is written in the same transaction as the
/// state change it announces; the relay publishes it to RabbitMQ afterwards.
model OutboxMessage {
  id             BigInt    @id @default(autoincrement())
  aggregateType  String    @map("aggregate_type") @db.VarChar(50)
  aggregateId    String    @map("aggregate_id") @db.VarChar(64)
  eventType      String    @map("event_type") @db.VarChar(100)
  payload        Json
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(200)
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  @@index([sentAt, id])
  @@map("outbox_messages")
}

/// A request to Core Banking to open a TCB account for a new-to-bank investor.
///
/// Kept here so the request survives a Core Banking outage and is sent exactly once;
/// the investor carries on registering while it is processed.
model AccountOpeningRequest {
  id            String    @id @default(uuid()) @db.Uuid
  /// AP-…
  reference     String    @unique @db.VarChar(12)
  /// One request per investor, so a retried submission cannot open two accounts.
  investorId    String    @unique @map("investor_id") @db.Uuid
  nidaNumber    String    @map("nida_number") @db.VarChar(20)
  fullName      String    @map("full_name") @db.VarChar(200)
  dateOfBirth   DateTime  @map("date_of_birth") @db.Date
  /// requested | opened | refused
  status        String    @default("requested") @db.VarChar(10)
  customerId    String?   @map("customer_id") @db.VarChar(40)
  accountNumber String?   @map("account_number") @db.VarChar(20)
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  openedAt      DateTime? @map("opened_at") @db.Timestamptz(6)

  @@index([status])
  @@map("account_opening_requests")
}
